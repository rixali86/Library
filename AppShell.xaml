<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:Library.Views"
       xmlns:helpers="clr-namespace:Library.Helpers"
       x:Class="Library.AppShell"
       Title="Library Management System"
       FlyoutBehavior="Flyout">

    <!-- ================= RESOURCES ================= -->
    <Shell.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#2196F3</Color>
            <Color x:Key="Secondary">#FF9800</Color>
            <Color x:Key="MemberColor">#2196F3</Color>
            <Color x:Key="LibrarianColor">#9C27B0</Color>

            <helpers:NotEmptyConverter x:Key="NotEmptyConverter" />
            <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
            <helpers:DueDateColorConverter x:Key="DueDateColorConverter" />
            <helpers:IntToBoolConverter x:Key="IntToBoolConverter" />
        </ResourceDictionary>
    </Shell.Resources>

    <!-- ================= HEADER ================= -->
    <Shell.FlyoutHeader>
        <Grid Padding="12" BackgroundColor="{StaticResource MemberColor}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Frame WidthRequest="56" HeightRequest="56"
                   CornerRadius="28"
                   BackgroundColor="White"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   Padding="0">
                <Label Text="{Binding UserInitials}"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       FontAttributes="Bold"
                       TextColor="{StaticResource MemberColor}" />
            </Frame>

            <StackLayout Grid.Column="1" Padding="8,0" VerticalOptions="Center">
                <Label Text="{Binding UserName}" 
                       FontAttributes="Bold" 
                       TextColor="White" />

                <Label Text="{Binding UserEmail}" 
                       FontSize="Micro" 
                       TextColor="White" 
                       Opacity="0.9" />

                <!-- 🔥 Dynamic Role Label -->
                <Label Text="{Binding UserRole}" 
                       FontSize="Micro"
                       TextColor="White"
                       BackgroundColor="#4CAF50"
                       Padding="4,0"
                       HorizontalOptions="Start" />
            </StackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- ================= MEMBER MENU ================= -->

    <FlyoutItem Title="Dashboard" Icon="home.png"
                IsVisible="{Binding IsMember}">
        <ShellContent Route="MemberDashboard"
                      ContentTemplate="{DataTemplate views:DashboardPage}" />
    </FlyoutItem>
    
    
    <FlyoutItem Title="Search Books" Icon="book.png"
                IsVisible="{Binding IsMember}">
        <ShellContent Route="Search"
                      ContentTemplate="{DataTemplate views:SearchBookPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Branches" Icon="loan.png"
               IsVisible="{Binding IsMember}">
        <ShellContent Route="Branches"
                             ContentTemplate="{DataTemplate views:BranchesPage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Events" Icon="events.png"
                IsVisible="{Binding IsMember}">
        <ShellContent Route="Events"
                      ContentTemplate="{DataTemplate views:EventsAttendedPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Members Loans" Icon="loan.png"
                IsVisible="{Binding IsMember}">
        <ShellContent Route="Loan"
                              ContentTemplate="{DataTemplate views:MemberLoansPage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Account" Icon="profile.png"
                IsVisible="{Binding IsMember}">
        <ShellContent Route="Profile"
                      ContentTemplate="{DataTemplate views:MemberProfilePage}" />
        <ShellContent Route="Setting"
                      ContentTemplate="{DataTemplate views:SettingsPage}" />
    </FlyoutItem>

    <!-- ================= LIBRARIAN MENU ================= -->

    <FlyoutItem Title="Librarian Dashboard" Icon="admin.png"
                IsVisible="{Binding IsLibrarian}">
        <ShellContent Route="LibrarianDashboard"
                      ContentTemplate="{DataTemplate views:LibrarianDashboardPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Manage Books" Icon="book.png"
                IsVisible="{Binding IsLibrarian}">
        <ShellContent Route="ManageBooks"
                      ContentTemplate="{DataTemplate views:ManageBooksPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Manage Members" Icon="users.png"
                IsVisible="{Binding IsLibrarian}">
        <ShellContent Route="ManageMembers"
                      ContentTemplate="{DataTemplate views:ManageMembersPage}" />
    </FlyoutItem>

    <!-- ================= FOOTER ================= -->

    <Shell.FlyoutFooter>
        <StackLayout Padding="12" Spacing="8">
            <Button Text="Logout"
                    ImageSource="logout.png"
                    BackgroundColor="#FF4444"
                    TextColor="White"
                    Clicked="OnLogoutClicked" />
        </StackLayout>
    </Shell.FlyoutFooter>

</Shell>
