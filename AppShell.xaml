<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:Library.Views"
       xmlns:helpers="clr-namespace:Library.Helpers"
       x:Class="Library.AppShell"
       Title="Library Management System">

    <Shell.Resources>
        <ResourceDictionary>
            <!-- Colors -->
            <Color x:Key="Primary">#2196F3</Color>
            <Color x:Key="Secondary">#FF9800</Color>

            <!-- Converters -->
            <helpers:NotEmptyConverter x:Key="NotEmptyConverter" />
            <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
            <helpers:DueDateColorConverter x:Key="DueDateColorConverter" />
            <helpers:IntToBoolConverter x:Key="IntToBoolConverter" />
        </ResourceDictionary>
    </Shell.Resources>

    <!-- Flyout Header: show current user -->
    <Shell.FlyoutHeader>
        <Grid Padding="12" BackgroundColor="{StaticResource Primary}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- simple avatar circle with initials -->
            <Frame WidthRequest="56" HeightRequest="56"
                   CornerRadius="28"
                   BackgroundColor="White"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   Padding="0">
                <Label Text="{Binding UserInitials}"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}" />
            </Frame>

            <StackLayout Grid.Column="1" Padding="8,0" VerticalOptions="Center">
                <Label Text="{Binding UserName}" FontAttributes="Bold" TextColor="White" />
                <Label Text="{Binding UserEmail}" FontSize="Micro" TextColor="White" Opacity="0.9" />
            </StackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- Flyout content -->
    <FlyoutItem Title="Home" Icon="home.png">
        <ShellContent Route="Dashboard"
                      ContentTemplate="{DataTemplate views:DashboardPage}"
                      Title="Dashboard" />
    </FlyoutItem>

    <FlyoutItem Title="Search Books" Icon="book.png">
        <ShellContent Route="Search"
                      ContentTemplate="{DataTemplate views:SearchBookPage}"
                      Title="Search Books" />
    </FlyoutItem>

  

    <FlyoutItem Title="Branches" Icon="branches.png">
        <ShellContent Route="Branches"
                      ContentTemplate="{DataTemplate views:BranchesPage}"
                      Title="Branches" />
    </FlyoutItem>

    <FlyoutItem Title="Events" Icon="events.png">
        <ShellContent Route="Events"
                      ContentTemplate="{DataTemplate views:EventsAttendedPage}"
                      Title="Events" />
    </FlyoutItem>

    <FlyoutItem Title="Account" Icon="profile.png">
        <ShellContent Route="Profile"
                      ContentTemplate="{DataTemplate views:MemberProfilePage}"
                      Title="My Profile" />
        <ShellContent Route="Setting"
                      ContentTemplate="{DataTemplate views:SettingsPage}"
                      Title="Settings" />
    </FlyoutItem>

    <!-- Footer with buttons (MenuItem cannot be placed inside a View collection) -->
    <Shell.FlyoutFooter>
        <StackLayout Padding="12" Spacing="8">
            <Button Text="Settings"
                    ImageSource="settings.png"
                    Command="{Binding GoToSettingsCommand}" />
            <Button Text="Logout"
                    ImageSource="logout.png"
                    Clicked="OnLogoutClicked" />
        </StackLayout>
    </Shell.FlyoutFooter>

</Shell>