<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Library.Views.FinesPage"
             Title="Manage Fines">

    <Grid RowDefinitions="Auto,Auto,*" Padding="12" RowSpacing="12">
        <!-- Summary -->
        <Frame Grid.Row="0" Padding="16" CornerRadius="12" BackgroundColor="#FF980010">
            <Grid ColumnDefinitions="*,*,*">
                <VerticalStackLayout Grid.Column="0" Spacing="4" HorizontalOptions="Center">
                    <Label Text="Pending Fines" FontSize="12" TextColor="Gray" />
                    <Label Text="{Binding PendingFinesCount}" FontSize="24" FontAttributes="Bold" TextColor="#FF9800" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                    <Label Text="Total Amount" FontSize="12" TextColor="Gray" />
                    <Label Text="{Binding TotalPendingAmount, StringFormat='${0:F2}'}" FontSize="24" FontAttributes="Bold" TextColor="#FF9800" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="Center">
                    <Label Text="Collected" FontSize="12" TextColor="Gray" />
                    <Label Text="{Binding TotalCollected, StringFormat='${0:F2}'}" FontSize="24" FontAttributes="Bold" TextColor="#4CAF50" />
                </VerticalStackLayout>
            </Grid>
        </Frame>

        <!-- Filter Tabs -->
        <Picker Grid.Row="1"
                ItemsSource="{Binding FilterOptions}"
                SelectedItem="{Binding SelectedFilter}"
                SelectedIndexChangedCommand="{Binding LoadFinesCommand}"
                Title="Filter fines" />

        <!-- Fines List -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Fines}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="12" Margin="0,4" CornerRadius="8">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                            <Label Grid.Row="0" Grid.Column="0" 
                                   Text="{Binding MemberName}" 
                                   FontSize="16" FontAttributes="Bold" />

                            <Label Grid.Row="1" Grid.Column="0" 
                                   Text="{Binding Reason}" 
                                   FontSize="14" TextColor="Gray" />

                            <HorizontalStackLayout Grid.Row="2" Grid.Column="0" Spacing="8">
                                <Label Text="{Binding CreatedAt, StringFormat='Date: {0:MMM dd, yyyy}'}" 
                                       FontSize="12" TextColor="Gray" />
                            </HorizontalStackLayout>

                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Grid.RowSpan="3" Spacing="4">
                                <Label Text="{Binding PenaltyAmount, StringFormat='${0:F2}'}" 
                                       FontSize="16" 
                                       FontAttributes="Bold"
                                       TextColor="{Binding AmountColor}"
                                       HorizontalOptions="End" />

                                <Button Text="{Binding ActionText}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ProcessFineCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="{Binding ActionColor}"
                                        TextColor="White"
                                        FontSize="12"
                                        CornerRadius="5"
                                        IsVisible="{Binding CanProcess}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>