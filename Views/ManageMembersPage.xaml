<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Library.ViewModels"
             xmlns:models="clr-namespace:Library.Models"
             x:DataType="vm:ManageMembersViewModel"
             x:Class="Library.Views.ManageMembersPage"
             Title="Manage Members">

    <Grid RowDefinitions="Auto,Auto,*" Padding="12" RowSpacing="12">

        <!-- Search Bar -->
        <SearchBar Grid.Row="0"
                   Placeholder="Search by name, email, or phone..."
                   Text="{Binding SearchQuery}"
                   SearchCommand="{Binding SearchCommand}" />

        <!-- Quick Stats -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <Frame Grid.Column="0" Padding="8" CornerRadius="8">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Total" FontSize="12" TextColor="Gray" />
                    <Label Text="{Binding TotalMembers}" FontSize="18" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Frame>

            <Frame Grid.Column="1" Padding="8" CornerRadius="8" BackgroundColor="#4CAF5010">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Active" FontSize="12" TextColor="Gray" />
                    <Label Text="{Binding ActiveMembers}" FontSize="18"
                           FontAttributes="Bold" TextColor="#4CAF50" />
                </VerticalStackLayout>
            </Frame>

            <Frame Grid.Column="2" Padding="8" CornerRadius="8" BackgroundColor="#F4433610">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Suspended" FontSize="12" TextColor="Gray" />
                    <Label Text="{Binding SuspendedMembers}" FontSize="18"
                           FontAttributes="Bold" TextColor="#F44336" />
                </VerticalStackLayout>
            </Frame>
        </Grid>

        <!-- Members List -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Members}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>

                <!-- ✅ x:DataType required for compiled bindings to fire -->
                <DataTemplate x:DataType="models:Member">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">

                                <SwipeItem Text="Edit"
                                           BackgroundColor="#2196F3"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ManageMembersViewModel}},
                                                             Path=EditMemberCommand}"
                                           CommandParameter="{Binding .}" />

                                <SwipeItem Text="Loans"
                                           BackgroundColor="#FF9800"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ManageMembersViewModel}},
                                                             Path=ViewLoansCommand}"
                                           CommandParameter="{Binding .}" />

                                <SwipeItem Text="Suspend"
                                           BackgroundColor="#F44336"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ManageMembersViewModel}},
                                                             Path=ToggleStatusCommand}"
                                           CommandParameter="{Binding .}" />

                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Frame Padding="12" Margin="0,4" CornerRadius="8" HasShadow="True">
                            <VerticalStackLayout Spacing="8">

                                <!-- User Info Row -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label Text="{Binding FullName}"
                                               FontSize="16" FontAttributes="Bold" />
                                        <Label Text="{Binding Email}"
                                               FontSize="14" TextColor="Gray" />
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding Phone}"
                                                   FontSize="12" TextColor="Gray" />
                                            <Label Text="·"
                                                   FontSize="12" TextColor="Gray" />
                                            <Label Text="{Binding RegisteredDate,
                                                          StringFormat='Joined: {0:MMM dd, yyyy}'}"
                                                   FontSize="12" TextColor="Gray" />
                                          
                                        </HorizontalStackLayout>
                                        <!-- ✅ Metadata chips display here -->
                                        <FlexLayout BindableLayout.ItemsSource="{Binding MetaRows}"
                Wrap="Wrap"
                Direction="Row"
                JustifyContent="Start"
                Margin="0,4,0,0">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="models:MemberMetadata">
                                                    <Frame BackgroundColor="#F0F4FF"
                       BorderColor="#C0CCEE"
                       CornerRadius="6"
                       Padding="6,3"
                       Margin="0,0,5,4"
                       HasShadow="False">
                                                        <HorizontalStackLayout Spacing="3">
                                                            <Label Text="{Binding MetaKey}"
                               FontSize="10"
                               TextColor="Gray" />
                                                            <Label Text=":"
                               FontSize="10"
                               TextColor="Gray" />
                                                            <Label Text="{Binding MetaValue}"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="#1A3A8C" />
                                                        </HorizontalStackLayout>
                                                    </Frame>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </FlexLayout>

                                        <!-- shows only when no meta exists -->
                                        <Label Text="No metadata added yet"
           FontSize="10"
           TextColor="#CCCCCC"
           IsVisible="{Binding MetaRows.Count,
               Converter={StaticResource InverseBoolConverter}}" />

                                    
                            </VerticalStackLayout>

                                    <Frame Grid.Column="1"
                                           BackgroundColor="{Binding StatusColor}"
                                           Padding="8,4"
                                           CornerRadius="15"
                                           HasShadow="False">
                                        <Label Text="{Binding AccountStatus}"
                                               FontSize="11"
                                               TextColor="White" />
                                    </Frame>
                                </Grid>

                                <!-- Divider -->
                                <BoxView HeightRequest="1" BackgroundColor="#EEEEEE" />

                                <!-- Metadata Buttons -->
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">

                                    <!-- ADD -->
                                    <Button Grid.Column="0"
                                            Text="+ Add Meta"
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            TextColor="White"
                                            BackgroundColor="#2D6B47"
                                            CornerRadius="6"
                                            HeightRequest="34"
                                            Padding="0"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ManageMembersViewModel}},
                                                              Path=AddMetaCommand}"
                                            CommandParameter="{Binding .}" />

                                    <!-- UPDATE -->
                                    <Button Grid.Column="1"
                                            Text="Edit Meta"
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            TextColor="White"
                                            BackgroundColor="#1A3A8C"
                                            CornerRadius="6"
                                            HeightRequest="34"
                                            Padding="0"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ManageMembersViewModel}},
                                                              Path=UpdateMetaCommand}"
                                            CommandParameter="{Binding .}" />

                                    <!-- DELETE -->
                                    <Button Grid.Column="2"
                                            Text="Del Meta"
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            TextColor="White"
                                            BackgroundColor="#8C1A1A"
                                            CornerRadius="6"
                                            HeightRequest="34"
                                            Padding="0"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ManageMembersViewModel}},
                                                              Path=DeleteMetaCommand}"
                                            CommandParameter="{Binding .}" />

                                </Grid>

                            </VerticalStackLayout>
                        </Frame>

                    </SwipeView>
                </DataTemplate>

            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>