<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Library.Views.SearchBookPage"
             Title="Search Books"
             xmlns:viewmodels="clr-namespace:Library.ViewModels">


    <StackLayout Padding="12" Spacing="12">
        <SearchBar Placeholder="Search by title or ISBN"
                   Text="{Binding SearchQuery}"
                   SearchCommand="{Binding SearchCommand}" />

        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" />

        <CollectionView ItemsSource="{Binding Titles}"
                        SelectionMode="Single"
                        SelectionChangedCommand="{Binding SelectTitleCommand}"
                        SelectionChangedCommandParameter="{Binding SelectedItem}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="6" Padding="8" HasShadow="True">
                        <StackLayout>
                            <Label Text="{Binding TitleName}" FontAttributes="Bold" />
                            <Label Text="{Binding Isbn}" FontSize="Small" TextColor="Gray" />
                            <Label Text="{Binding Publisher}" FontSize="Micro" TextColor="DarkGray" />
                            <Label Text="{Binding Author}" FontSize="Micro" TextColor="DarkGray" />
                            <Label Text="{Binding PublicationYear}" FontSize="Micro" TextColor="DarkGray" />
                            
                        </StackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </StackLayout>
</ContentPage>