<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Library.Views.AddEditBookPage"
             Title="{Binding PageTitle}"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="20">

            <!-- Book Details -->
            <Frame Padding="16" CornerRadius="12" HasShadow="False" BorderColor="#EEE">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Book Information" FontSize="18" FontAttributes="Bold" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Title *" FontSize="14" TextColor="Gray"/>
                        <Entry Text="{Binding Book.TitleName}" Placeholder="Enter title"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="ISBN" FontSize="14" TextColor="Gray"/>
                        <Entry Text="{Binding Book.Isbn}" Placeholder="Enter ISBN"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Publisher" FontSize="14" TextColor="Gray"/>
                        <Entry Text="{Binding Book.Publisher}" Placeholder="Publisher"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Publication Year" FontSize="14" TextColor="Gray"/>
                        <Entry Text="{Binding Book.PublicationYear}" Placeholder="Year" Keyboard="Numeric"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout  Spacing="4">
                 
                        <Label Text="Created At" FontSize="14" TextColor="Gray" />
                        <DatePicker 
Date="{Binding Book.UpdatedAt}"
                            IsEnabled="True"
                            
Format="dd MMM yyyy" />
                        
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4"    >
                        <Label Text="Last Updated" FontSize="14" TextColor="Gray" />
                        <DatePicker 
Date="{Binding Book.UpdatedAt}" IsEnabled="False"
Format="dd MMM yyyy" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Extra Information" FontSize="14" TextColor="Gray"/>
                        <Label Text="{Binding Book.ExtraInfo}" TextColor="Black" BackgroundColor="#F0F0F0" Padding="8" />
                    </VerticalStackLayout>
                    <Button 
    Text="Add Extra Info" 
    Command="{Binding AddExtraInfoCommand}" 
    BackgroundColor="#FF9800" 
    TextColor="White"
    HeightRequest="50"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Authors Section -->
            <Frame Padding="16" CornerRadius="12" HasShadow="False" BorderColor="#EEE">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="FillAndExpand">
                        <Label Text="Authors" FontSize="16" FontAttributes="Bold"/>
                        <Button Text="+ Add Author" Command="{Binding AddAuthorCommand}" BackgroundColor="#2196F3" TextColor="White" HeightRequest="30"/>
                    </HorizontalStackLayout>
                    <CollectionView ItemsSource="{Binding Authors}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                                    <Entry Grid.Column="0" Text="{Binding AuthorName}" Placeholder="Author name"/>
                                    <Button Grid.Column="1" Text="❌" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveAuthorCommand}" CommandParameter="{Binding .}" BackgroundColor="Transparent" TextColor="Red"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <!-- Copies Section -->
            <Frame Padding="16" CornerRadius="12" HasShadow="False" BorderColor="#EEE">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="FillAndExpand">
                        <Label Text="Copies" FontSize="16" FontAttributes="Bold"/>
                        <Button Text="+ Add Copy" Command="{Binding AddCopyCommand}" BackgroundColor="#4CAF50" TextColor="White" HeightRequest="30"/>
                    </HorizontalStackLayout>
                    <CollectionView ItemsSource="{Binding Copies}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,4" ColumnSpacing="8">
                                    <Entry Grid.Column="0" Text="{Binding Barcode}" Placeholder="Barcode"/>
                                    <Picker Grid.Column="1" Title="Condition" ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ConditionOptions}" SelectedItem="{Binding ConditionStatus}"/>
                                    <Button Grid.Column="2" Text="❌" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveCopyCommand}" CommandParameter="{Binding .}" BackgroundColor="Transparent" TextColor="Red"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <!-- Branch Selection -->
            <Frame Padding="16" CornerRadius="12" HasShadow="False" BorderColor="#EEE">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Assign Branch *" FontSize="16" FontAttributes="Bold"/>
                    <Picker Title="Select Branch" ItemsSource="{Binding Branches}" ItemDisplayBinding="{Binding BranchName}" SelectedItem="{Binding SelectedBranch}"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Action Buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0" Text="Cancel" Command="{Binding CancelCommand}" BackgroundColor="Gray" TextColor="White" HeightRequest="50"/>
                <Button Grid.Column="1" Text="{Binding SaveButtonText}" Command="{Binding SaveCommand}" BackgroundColor="#4CAF50" TextColor="White" HeightRequest="50"/>
            </Grid>

            <ActivityIndicator IsRunning="{Binding IsSaving}" IsVisible="{Binding IsSaving}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>