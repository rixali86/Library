<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Library.Views.SettingsPage"
             Title="Settings"
             xmlns:viewmodels="clr-namespace:Library.ViewModels">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="Appearance" FontAttributes="Bold" />
            <Picker Title="Theme"
                    ItemsSource="{Binding Themes}"
                    SelectedItem="{Binding SelectedTheme}" />

            <Label Text="Notifications" FontAttributes="Bold" />
            <HorizontalStackLayout VerticalOptions="Center" Spacing="12">
                <Label Text="Enable notifications" VerticalOptions="Center" />
                <Switch IsToggled="{Binding NotificationsEnabled}" />
            </HorizontalStackLayout>

            <Label Text="Language" FontAttributes="Bold" />
            <Picker Title="Language"
                    ItemsSource="{Binding Languages}"
                    SelectedItem="{Binding SelectedLanguage}" />

            <BoxView HeightRequest="1" Color="#E0E0E0" />

            <Button Text="Report a Problem" Command="{Binding ReportProblemCommand}" />
            <Button Text="Terms AND Privacy Policy" Command="{Binding OpenTermsCommand}" />
            <Button Text="Partner With Us" Command="{Binding PartnerWithUsCommand}" />
            <Button Text="Check for Updates" Command="{Binding CheckForUpdatesCommand}" />
            <Button Text="Connect With Us" Command="{Binding ConnectWithUsCommand}" />
            <Button Text="Invite Friends" Command="{Binding InviteFriendsCommand}" />

            <Label Text="{Binding StatusMessage}" TextColor="Gray" FontSize="Small" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>