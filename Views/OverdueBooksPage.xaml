<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Library.Views.OverdueBooksPage"
             Title="Overdue Books">

    <Grid RowDefinitions="Auto,Auto,*" Padding="12" RowSpacing="12">
        <!-- Summary -->
        <Frame Grid.Row="0" Padding="16" CornerRadius="12" BackgroundColor="#F4433610">
            <Grid ColumnDefinitions="*,*,*">
                <VerticalStackLayout Grid.Column="0" Spacing="4" HorizontalOptions="Center">
                    <Label Text="Total Overdue" FontSize="12" TextColor="Gray" />
                    <Label Text="{Binding TotalOverdue}" FontSize="24" FontAttributes="Bold" TextColor="#F44336" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                    <Label Text="Total Fine" FontSize="12" TextColor="Gray" />
                    <Label Text="{Binding TotalFine, StringFormat='${0:F2}'}" FontSize="24" FontAttributes="Bold" TextColor="#F44336" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="Center">
                    <Label Text="Days Overdue" FontSize="12" TextColor="Gray" />
                    <Label Text="{Binding AvgDaysOverdue}" FontSize="24" FontAttributes="Bold" TextColor="#F44336" />
                </VerticalStackLayout>
            </Grid>
        </Frame>

        <!-- Filter -->
        <HorizontalStackLayout Grid.Row="1" Spacing="8">
            <Picker Title="Filter by"
                    ItemsSource="{Binding FilterOptions}"
                    SelectedItem="{Binding SelectedFilter}"
                    WidthRequest="120" />
            <Button Text="Apply"
                    Command="{Binding ApplyFilterCommand}"
                    BackgroundColor="#2196F3"
                    TextColor="White" />
        </HorizontalStackLayout>

        <!-- Overdue List -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding OverdueLoans}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="12" Margin="0,4" CornerRadius="8">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                            <Label Grid.Row="0" Grid.Column="0" 
                                   Text="{Binding BookTitle}" 
                                   FontSize="16" FontAttributes="Bold" />

                            <Label Grid.Row="1" Grid.Column="0" 
                                   Text="{Binding MemberFullName}" 
                                   FontSize="14" TextColor="Gray" />

                            <HorizontalStackLayout Grid.Row="2" Grid.Column="0" Spacing="8">
                                <Label Text="Due:" FontSize="12" TextColor="Gray" />
                                <Label Text="{Binding DueDatetime, StringFormat='{0:MMM dd, yyyy}'}" 
                                       FontSize="12" TextColor="Red" />
                                <Label Text="�" FontSize="12" TextColor="Gray" />
                                <Label Text="{Binding DaysOverdue, StringFormat='{0} days overdue'}" 
                                       FontSize="12" TextColor="Red" />
                            </HorizontalStackLayout>

                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Grid.RowSpan="3" Spacing="4">
                                <Label Text="{Binding FineAmount, StringFormat='Fine: ${0:F2}'}" 
                                       FontSize="12" 
                                       TextColor="Red"
                                       HorizontalOptions="End" />
                                <Button Text="Notify"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SendReminderCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#FF9800"
                                        TextColor="White"
                                        FontSize="12"
                                        CornerRadius="5" />
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>