<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Library.Views.ReportsPage"
             Title="Reports  Analytics">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="20">

         
            <Frame Padding="16" CornerRadius="12">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Select Period" FontSize="16" FontAttributes="Bold" />

                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                        <DatePicker Grid.Column="0" Date="{Binding StartDate}" />
                        <DatePicker Grid.Column="1" Date="{Binding EndDate}" />
                        <Button Grid.Column="2"
                                Text="Apply"
                                Command="{Binding ApplyDateRangeCommand}"
                                BackgroundColor="#2196F3"
                                TextColor="White"
                                CornerRadius="8" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Quick Stats -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Frame Grid.Column="0" Padding="12" CornerRadius="8">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="" FontSize="24" HorizontalOptions="Center" />
                        <Label Text="Total Loans" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
                        <Label Text="{Binding TotalLoans}" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Column="1" Padding="12" CornerRadius="8">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="" FontSize="24" HorizontalOptions="Center" />
                        <Label Text="Fines Collected" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
                        <Label Text="{Binding TotalFines, StringFormat='${0:F2}'}" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Column="2" Padding="12" CornerRadius="8">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="" FontSize="24" HorizontalOptions="Center" />
                        <Label Text="Active Members" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
                        <Label Text="{Binding ActiveMembers}" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Popular Books Chart -->
            <Frame Padding="16" CornerRadius="12">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Most Popular Books" FontSize="16" FontAttributes="Bold" />

                    <CollectionView ItemsSource="{Binding PopularBooks}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                                    <Label Grid.Column="0" Text="{Binding TitleName}" FontSize="14" />
                                    <Label Grid.Column="1" 
                                           Text="{Binding LoanCount, StringFormat='{0} loans'}" 
                                           FontSize="12" 
                                           TextColor="Gray" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <!-- Member Activity -->
            <Frame Padding="16" CornerRadius="12">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Member Activity" FontSize="16" FontAttributes="Bold" />

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                        <Label Grid.Row="0" Grid.Column="0" Text="New Members" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding NewMembers}" FontAttributes="Bold" HorizontalOptions="End" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Active Borrowers" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding ActiveBorrowers}" FontAttributes="Bold" HorizontalOptions="End" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Export Buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="Export to CSV"
                        Command="{Binding ExportToCsvCommand}"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        CornerRadius="8" />

                <Button Grid.Column="1"
                        Text="Print Report"
                        Command="{Binding PrintReportCommand}"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        CornerRadius="8" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>