<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:Library.Helpers"
             x:Class="Library.Views.ManageBooksPage"
             Title="Manage Books"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <helpers:IntToBoolConverter x:Key="IntToBoolConverter" />
            <Color x:Key="Primary">#2196F3</Color>
            <Color x:Key="Success">#4CAF50</Color>
            <Color x:Key="Warning">#FF9800</Color>
            <Color x:Key="Danger">#F44336</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="12" RowSpacing="12">
        <!-- Search and Add Section -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <SearchBar Grid.Column="0"
                       Placeholder="Search by title, author, ISBN..."
                       Text="{Binding SearchQuery}"
                       SearchCommand="{Binding SearchCommand}" />
           
        </Grid>
        <HorizontalStackLayout Grid.Row="1" Spacing="8">

            <Button Grid.Column="1"
         Text="+ Add Book"
         Command="{Binding AddBookCommand}"
         BackgroundColor="{StaticResource Success}"
         TextColor="White"
         CornerRadius="8"
         WidthRequest="100" />

            <Button Grid.Column="1"
         Text="+ Edit Book"
         Command="{Binding EditBookCommand}"
         BackgroundColor="{StaticResource Success}"
         TextColor="White"
         CornerRadius="8"
         WidthRequest="100" />
        </HorizontalStackLayout>

        <!-- Filter Section -->
        <HorizontalStackLayout Grid.Row="2" Spacing="8">
            <Picker Title="Filter by"
                    ItemsSource="{Binding FilterOptions}"
                    SelectedItem="{Binding SelectedFilter}"
                    WidthRequest="120" />

            <Button Text="Apply Filter"
                    Command="{Binding ApplyFilterCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="8" />

            <Button Text="Clear"
                    Command="{Binding ClearFilterCommand}"
                    BackgroundColor="Gray"
                    TextColor="White"
                    CornerRadius="8" />
        </HorizontalStackLayout>

        <!-- Summary Stats -->
        <Grid Grid.Row="3" ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <Frame Grid.Column="0" Padding="8" CornerRadius="8" BackgroundColor="{StaticResource Primary}">
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Label Text="Total Books" FontSize="12" TextColor="Gray" />
                    <Label Text="{Binding TotalBooks}" FontSize="18" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Frame>

            <Frame Grid.Column="1" Padding="8" CornerRadius="8" BackgroundColor="{StaticResource Success}">
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Label Text="Available" FontSize="12" TextColor="Gray" />
                    <Label Text="{Binding AvailableBooks}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Success}" />
                </VerticalStackLayout>
            </Frame>

            <Frame Grid.Column="2" Padding="8" CornerRadius="8" BackgroundColor="{StaticResource Warning}">
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Label Text="Checked Out" FontSize="12" TextColor="Gray" />
                    <Label Text="{Binding CheckedOutBooks}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Warning}" />
                </VerticalStackLayout>
            </Frame>
        </Grid>

        <!-- Books List -->
        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding Books}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem Text="Edit" 
                                           BackgroundColor="{StaticResource Primary}"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditBookCommand}"
                                           CommandParameter="{Binding .}" />
                                <SwipeItem Text="Delete" 
                                           BackgroundColor="{StaticResource Danger}"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteBookCommand}"
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Frame Padding="12" Margin="0,4" CornerRadius="8" HasShadow="False" BorderColor="#EEE">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="{Binding TitleName}" 
                                           FontSize="16" FontAttributes="Bold" />
                                    <Label Text="{Binding Author}" 
                                           FontSize="14" TextColor="Gray" />
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding Isbn}" FontSize="12" TextColor="Gray" />
                                        <Label Text="�" FontSize="12" TextColor="Gray" />
                                        <Label Text="{Binding PublicationYear}" FontSize="12" TextColor="Gray"  />
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding Publisher}" FontSize="12" TextColor="Gray"  />
                                   <!-- Metadata -->
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Text="{Binding CreatedAt, StringFormat='Added: {0:dd MMM yyyy}'}"
               FontSize="11"
               TextColor="#888" BackgroundColor="red" />

                                        <Label Text="{Binding UpdatedAt, StringFormat='Updated: {0:dd MMM yyyy}'}"
               FontSize="11"
               TextColor="#888"  BackgroundColor="red"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                
                                

                                <Frame Grid.Column="1"
                                       BackgroundColor="{Binding StatusColor}"
                                       Padding="8,4"
                                       CornerRadius="15">
                                    <Label Text="{Binding Status}" 
                                           FontSize="11"
                                           TextColor="White" />
                                </Frame>

                                <Button Grid.Column="2"
                                        Text="View Copies"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ViewCopiesCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="{StaticResource Primary}"
                                        TextColor="White"
                                        FontSize="12"
                                        CornerRadius="5" />
                            </Grid>
                        </Frame>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="40" Spacing="20" HorizontalOptions="Center">
                    <Label Text="" FontSize="48" HorizontalOptions="Center" Opacity="0.5" />
                    <Label Text="No books found" FontSize="18" TextColor="Gray" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <ActivityIndicator Grid.Row="3"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           VerticalOptions="Center" />
    </Grid>
</ContentPage>