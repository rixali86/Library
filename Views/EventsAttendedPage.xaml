<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Library.ViewModels"
             x:Class="Library.Views.EventsAttendedPage"
             Title="My Events">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="12">

        <Label Grid.Row="0"
               Text="My Events"
               FontSize="20"
               FontAttributes="Bold"
               Margin="0,0,0,8"/>

        <!-- Filter Picker — bound to SelectedFilterIndex (int) not the enum -->
        <Picker Grid.Row="1"
                Title="Select Event Type"
                SelectedIndex="{Binding SelectedFilterIndex, Mode=TwoWay}">
            <Picker.Items>
                <x:String>Registered</x:String>
                <x:String>Attended</x:String>
                <x:String>Missed</x:String>
                <x:String>Past All</x:String>
            </Picker.Items>
        </Picker>

        <!-- Search -->
        <SearchBar Grid.Row="2"
                   Placeholder="Search events..."
                   Text="{Binding SearchText}"
                   Margin="0,5"/>

        <!-- List -->
        <RefreshView Grid.Row="3"
                     IsRefreshing="{Binding IsLoading}"
                     Command="{Binding LoadDataCommand}">

            <CollectionView ItemsSource="{Binding FilteredEvents}"
                            EmptyView="No events found.">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="6" Padding="10" CornerRadius="8">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Title}"
                                       FontAttributes="Bold"
                                       FontSize="15"/>
                                <Label Text="{Binding BranchName}"
                                       TextColor="Gray"
                                       FontSize="13"/>
                                <Label Text="{Binding StartDatetime, StringFormat='{0:MMM d, yyyy h:mm tt}'}"
                                       FontSize="13"/>
                                <Label Text="{Binding AttendanceStatus}"
                                       TextColor="Green"
                                       FontSize="12"/>
                                <button Text="View Details"
                                       Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EventsAttendedViewModel}}, Path=ViewEventDetailsCommand}"
                                       CommandParameter="{Binding .}"
                                       FontSize="13"/>
                            </VerticalStackLayout>

                            
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </RefreshView>

    </Grid>
</ContentPage>