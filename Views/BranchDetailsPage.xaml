                            <VerticalStackLayout>
                                <Label Text="{Binding Name}" FontAttributes="Bold" />
                                <Label Text="{Binding Role}" FontSize="12" TextColor="Gray" />
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding Phone}" />
                                    <Label Text="�" />
                                    <Label Text="{Binding Email}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView> -->

            <Label Text="Hours" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding Branch.Hours}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding Display}" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>