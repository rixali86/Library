<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Library.Views.BooksPage"
             Title="Books Management"
             Shell.BackgroundColor="#6366F1">

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="0">

        <!-- Header Section -->
        <Grid Grid.Row="0" 
              BackgroundColor="#6366F1" 
              Padding="20,30,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title -->
            <Label Grid.Row="0"
                   Text="?? Books Library"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="White" />

            <!-- Stats Cards -->
            <Grid Grid.Row="1" 
                  Margin="0,20,0,0"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="15">

                <!-- Total Books Card -->
                <Frame Grid.Column="0"
                       BackgroundColor="White"
                       Padding="15"
                       CornerRadius="12"
                       HasShadow="False">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="??" FontSize="24" />
                        <Label Text="{Binding TotalBooks}" 
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#6366F1" />
                        <Label Text="Titles" 
                               FontSize="12"
                               TextColor="#64748B" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Total Copies Card -->
                <Frame Grid.Column="1"
                       BackgroundColor="White"
                       Padding="15"
                       CornerRadius="12"
                       HasShadow="False">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="??" FontSize="24" />
                        <Label Text="{Binding TotalCopies}" 
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#EC4899" />
                        <Label Text="Copies" 
                               FontSize="12"
                               TextColor="#64748B" />
                    </VerticalStackLayout>
                </Frame>
            </Grid>
        </Grid>

        <!-- Search & Filter Section -->
        <VerticalStackLayout Grid.Row="1" 
                           Padding="20,20,20,15"
                           BackgroundColor="#6366F1"
                           Spacing="12">

            <!-- Search Bar -->
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="5">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <Entry Grid.Column="0"
                           Placeholder="Search by title or author..."
                           Text="{Binding SearchQuery}"
                           ReturnCommand="{Binding SearchBooksCommand}"
                           ClearButtonVisibility="WhileEditing"
                           FontSize="14"
                           Margin="10,0" />

                    <Button Grid.Column="1"
                            Text="??"
                            BackgroundColor="Transparent"
                            TextColor="#6366F1"
                            Command="{Binding SearchBooksCommand}"
                            FontSize="20"
                            Padding="10,0" />

                    <Button Grid.Column="2"
                            Text="+"
                            BackgroundColor="#10B981"
                            TextColor="White"
                            Command="{Binding AddNewBookCommand}"
                            FontSize="24"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            WidthRequest="45"
                            HeightRequest="45" />
                </Grid>
            </Border>

            <!-- Publisher Filter -->
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="10,5">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Picker ItemsSource="{Binding Publishers}"
                        SelectedItem="{Binding SelectedPublisher}"
                        Title="Filter by Publisher"
                        FontSize="14"
                        TextColor="#1E293B" />
            </Border>

            <!-- Clear Filters Button -->
            <Button Text="Clear Filters"
                    BackgroundColor="White"
                    TextColor="#6366F1"
                    Command="{Binding ClearFiltersCommand}"
                    CornerRadius="12"
                    FontSize="13"
                    IsVisible="{Binding HasSearched}" />
        </VerticalStackLayout>

        <!-- Books List Section -->
        <Grid Grid.Row="2" BackgroundColor="#F8FAFC">

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                             IsVisible="{Binding IsLoading}"
                             Color="#6366F1"
                             HorizontalOptions="Center"
                             VerticalOptions="Center" />

            <!-- Books List -->
            <RefreshView IsRefreshing="{Binding IsLoading}"
                        Command="{Binding LoadDataCommand}"
                        IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}">
                <ScrollView>
                    <CollectionView ItemsSource="{Binding Books}"
                                  SelectionMode="None"
                                  Margin="15,15,15,15">

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeThickness="0"
                                        BackgroundColor="White"
                                        Margin="0,0,0,15">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Opacity="0.1" Radius="10" Offset="0,2" />
                                    </Border.Shadow>

                                    <Grid Padding="15" 
                                          RowDefinitions="Auto,Auto,Auto,Auto"
                                          RowSpacing="8">

                                        <!-- Title Row -->
                                        <HorizontalStackLayout Grid.Row="0" Spacing="10">
                                            <Label Text="??"
                                                   FontSize="24"
                                                   VerticalOptions="Start" />

                                            <VerticalStackLayout Spacing="4" HorizontalOptions="FillAndExpand">
                                                <Label Text="{Binding TitleName}"
                                                       FontSize="18"
                                                       FontAttributes="Bold"
                                                       TextColor="#1E293B"
                                                       LineBreakMode="WordWrap" />

                                                <Label Text="{Binding Authors, StringFormat='by {0}'}"
                                                       FontSize="14"
                                                       TextColor="#64748B"
                                                       LineBreakMode="WordWrap" />
                                            </VerticalStackLayout>
                                        </HorizontalStackLayout>

                                        <!-- Publication Info -->
                                        <HorizontalStackLayout Grid.Row="1" Spacing="15">
                                            <HorizontalStackLayout Spacing="5">
                                                <Label Text="??" FontSize="14" />
                                                <Label Text="{Binding PublicationInfo}"
                                                       FontSize="13"
                                                       TextColor="#64748B" />
                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout Spacing="5">
                                                <Label Text="??" FontSize="14" />
                                                <Label Text="{Binding Isbn}"
                                                       FontSize="13"
                                                       TextColor="#64748B" />
                                            </HorizontalStackLayout>
                                        </HorizontalStackLayout>

                                        <!-- Copies Information -->
                                        <Grid Grid.Row="2" 
                                              ColumnDefinitions="Auto,*,Auto"
                                              ColumnSpacing="10">

                                            <!-- Availability Badge -->
                                            <Border Grid.Column="0"
                                                    BackgroundColor="{Binding AvailabilityColor}"
                                                    Padding="10,5"
                                                    StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="6" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding AvailabilityText}"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="White" />
                                            </Border>

                                            <!-- Copies Stats -->
                                            <HorizontalStackLayout Grid.Column="1" 
                                                                 Spacing="15"
                                                                 VerticalOptions="Center">
                                                <HorizontalStackLayout Spacing="3">
                                                    <Label Text="??" FontSize="12" />
                                                    <Label Text="{Binding TotalCopies, StringFormat='{0} total'}"
                                                           FontSize="12"
                                                           TextColor="#64748B" />
                                                </HorizontalStackLayout>

                                                <HorizontalStackLayout Spacing="3">
                                                    <Label Text="?" 
                                                           FontSize="12"
                                                           TextColor="#10B981" />
                                                    <Label Text="{Binding AvailableCopies, StringFormat='{0} available'}"
                                                           FontSize="12"
                                                           TextColor="#10B981" />
                                                </HorizontalStackLayout>

                                                <HorizontalStackLayout Spacing="3">
                                                    <Label Text="?" 
                                                           FontSize="12"
                                                           TextColor="#EF4444" />
                                                    <Label Text="{Binding BorrowedCopies, StringFormat='{0} borrowed'}"
                                                           FontSize="12"
                                                           TextColor="#EF4444" />
                                                </HorizontalStackLayout>
                                            </HorizontalStackLayout>

                                            <!-- Arrow -->
                                            <Label Grid.Column="2"
                                                   Text="›"
                                                   FontSize="30"
                                                   TextColor="#CBD5E1"
                                                   VerticalOptions="Center" />
                                        </Grid>

                                        <!-- Copies Preview (if any) -->
                                        <FlexLayout Grid.Row="3"
                                                   Wrap="Wrap"
                                                   JustifyContent="Start"
                                                   AlignItems="Start"
                                                   IsVisible="{Binding Copies.Count, Converter={StaticResource IntToBoolConverter}}">
                                            <BindableLayout.ItemsSource>
                                                <Binding Path="Copies" />
                                            </BindableLayout.ItemsSource>
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BackgroundColor="{Binding StatusColor}"
                                                            Padding="6,3"
                                                            Margin="0,0,5,5"
                                                            StrokeThickness="0"
                                                            Opacity="0.2">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="4" />
                                                        </Border.StrokeShape>
                                                        <Label Text="{Binding BranchName}"
                                                               FontSize="10"
                                                               TextColor="White" />
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </FlexLayout>

                                    </Grid>

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ViewBookDetailsCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <!-- Empty State -->
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="40" 
                                               Spacing="15"
                                               VerticalOptions="Center">
                                <Label Text="??"
                                       FontSize="60"
                                       HorizontalOptions="Center"
                                       Opacity="0.3" />
                                <Label Text="No books found"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       TextColor="#64748B" />
                                <Label Text="Try adjusting your search or filters"
                                       FontSize="14"
                                       HorizontalOptions="Center"
                                       TextColor="#94A3B8" />
                                <Button Text="Add New Book"
                                        Command="{Binding AddNewBookCommand}"
                                        BackgroundColor="#6366F1"
                                        TextColor="White"
                                        CornerRadius="12"
                                        Margin="0,20,0,0"
                                        Padding="20,12" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>

                    </CollectionView>
                </ScrollView>
            </RefreshView>

            <!-- Initial State (Before Search) -->
            <VerticalStackLayout Padding="40" 
                               Spacing="15"
                               IsVisible="{Binding HasSearched, Converter={StaticResource InverseBoolConverter}}"
                               VerticalOptions="Center">
                <Label Text="??"
                       FontSize="60"
                       HorizontalOptions="Center"
                       Opacity="0.3" />
                <Label Text="Manage Your Books"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="#64748B" />
                <Label Text="Search for books or add new titles to your library"
                       FontSize="14"
                       HorizontalOptions="Center"
                       TextColor="#94A3B8"
                       HorizontalTextAlignment="Center" />
                <Button Text="Browse All Books"
                        Command="{Binding SearchBooksCommand}"
                        BackgroundColor="#6366F1"
                        TextColor="White"
                        CornerRadius="12"
                        Margin="0,20,0,0"
                        Padding="20,12" />
            </VerticalStackLayout>

        </Grid>

    </Grid>

</ContentPage>
