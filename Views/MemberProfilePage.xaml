<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Library.Views.MemberProfilePage"
             Title="My Profile"
             xmlns:viewmodels="clr-namespace:Library.ViewModels">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" />

            <Label Text="First Name" />
            <Entry Text="{Binding FirstName}" />

            <Label Text="Last Name" />
            <Entry Text="{Binding LastName}" />

            <Label Text="Date of Birth" />
            <DatePicker Date="{Binding DateOfBirth, Mode=TwoWay}" />

            <Label Text="Email" />
            <Entry Text="{Binding Email}" IsReadOnly="True" />

            <Label Text="Phone" />
            <Entry Text="{Binding Phone}" Keyboard="Telephone"  IsReadOnly="True"/>

            <Label Text="Registered Date" />
            <Entry Text="{Binding RegisteredDate}" Keyboard="Telephone"  IsReadOnly="True"/>

            <Label Text="Account Created" />
            <Entry Text="{Binding CreatedAt}" Keyboard="Telephone"  IsReadOnly="True"/>



            <Button Text="Save" Command="{Binding SaveCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>